  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/algorithms/lua dist/algorithms/lua && cp -r src/policy/lua dist/policy/lua",
