# Copy to .env. Docker Compose reads it automatically.
# Outside Compose: node --env-file=.env dist/main.js
# Every variable is documented in docs/configuration.md. Values shown are the defaults.

# Port and address the HTTP server listens on
PORT=8080
HOST=0.0.0.0

# Redis holding limiter state and shared policies (Compose overrides this to its own redis service)
REDIS_URL=redis://127.0.0.1:6379

# Timeout for every Redis call, in milliseconds
REDIS_COMMAND_TIMEOUT_MS=1000

# What to do when Redis cannot answer: fail-open (allow) or fail-closed (deny with 503)
FAIRLY_FAILURE_MODE=fail-open

# Retry-After sent with a fail-closed 503, in seconds
FAIRLY_FAIL_CLOSED_RETRY_AFTER_SECONDS=1

# Seed policies, written to Redis the first time it is used
FAIRLY_CONFIG=fairly.config.json

# How often each instance re-reads policies from Redis, in milliseconds
POLICY_REFRESH_MS=2000

# Admin API token, at least 16 characters. Leave empty to disable the admin API.
# Generate one with: openssl rand -hex 32
FAIRLY_ADMIN_TOKEN=

# Time allowed for in-flight requests to finish on SIGTERM or SIGINT, in milliseconds
FAIRLY_SHUTDOWN_TIMEOUT_MS=10000

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
