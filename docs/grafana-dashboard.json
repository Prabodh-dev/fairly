        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis failures and degraded decisions",
      "description": "Degraded decisions are checks answered by the failure mode instead of by Redis",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (operation, mode) (rate(fairly_redis_failures_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "failure {{operation}} ({{mode}})",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (mode, decision) (rate(fairly_degraded_decisions_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "degraded {{mode}} {{decision}}",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
