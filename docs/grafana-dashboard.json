  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "fairly",
    "rate-limiting"
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(fairly_policies, instance)",
          "refId": "instances"
        },
        "definition": "label_values(fairly_policies, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "fairly",
  "uid": "fairly-overview",
  "version": 1
}
